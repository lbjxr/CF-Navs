{
  "name": "cf-navs",
  "version": "0.9.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev:web": "vite",
    "build": "vite build",
    "build:icon-compat": "vite build --mode icon-compat",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "type-check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json && npm run type-check:tests",
    "type-check:tests": "tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint . --max-warnings 0",
    "test": "node --experimental-sqlite node_modules/vitest/vitest.mjs run",
    "smoke": "node scripts/smoke-local.mjs",
    "perf:audit": "node scripts/perf-audit.mjs",
    "regression:chrome": "node scripts/chrome-regression.mjs",
    "accept:prod": "node scripts/prod-acceptance.mjs",
    "setup:wrangler": "node scripts/create-wrangler-local.mjs",
    "wrangler": "node scripts/wrangler-config.mjs",
    "dev": "node scripts/wrangler-config.mjs dev",
    "deploy": "npm run build && node scripts/wrangler-config.mjs deploy",
    "db:init": "node scripts/wrangler-config.mjs d1 execute DB --local --file=./schema.sql",
    "db:init:remote": "node scripts/wrangler-config.mjs d1 execute DB --remote --file=./schema.sql",
    "build:server": "esbuild server/index.ts server/migrate.ts --bundle --platform=node --target=node24 --format=esm --loader:.sql=text --outdir=dist-server --out-extension:.js=.mjs",
    "start:server": "node --experimental-sqlite dist-server/index.mjs",
    "type-check:server": "tsc --noEmit -p tsconfig.server.json"
  },
  "cloudflare": {
    "label": "CF-Navs",
    "products": [
      "Workers",
      "D1",
      "KV"
    ],
    "bindings": {
      "DB": {
        "description": "D1 database for categories, bookmarks, settings, and installer-managed schema initialization."
      },
      "SESSION": {
        "description": "KV namespace for HttpOnly administrator sessions; the installer also verifies this required binding before setup."
      }
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@eslint/js": "^9.39.5",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.4",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.0",
    "ws": "^8.21.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.5",
    "sortablejs": "^1.15.3"
  }
}
